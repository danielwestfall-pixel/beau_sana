# Copy to slack-config.env on the user's PC. The actual file is gitignored.
# Obtain client ID and secret from the Slack app's Basic Information page.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
# Public HTTPS URL forwarded to this local app; register this exact URL in Slack.
SLACK_REDIRECT_URI=https://YOUR-CALLBACK-HOST/api/slack/oauth/callback
SLACK_WORKSPACE_DOMAIN=quavered
SLACK_DEFAULT_CHANNEL_ID=C0C7Q7AJT7Y
# Optional Slack workspace team ID (starts with T), if known.
SLACK_WORKSPACE_ID=
# Set true ONLY if the default channel is private; add groups user scopes.
SLACK_PRIVATE_CHANNEL=false
# Set true to include active group DMs; add mpim user scopes.
SLACK_GROUP_DMS=false
