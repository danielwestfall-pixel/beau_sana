{
  "display_information": {
    "name": "BeauSana accessibility dashboard",
    "description": "Simple Slack messages, file sharing and responses"
  },
  "oauth_config": {
    "redirect_urls": ["https://YOUR-CALLBACK-HOST/api/slack/oauth/callback"],
    "scopes": {
      "user": ["channels:read", "channels:history", "im:read", "im:history", "users:read", "chat:write", "files:read", "files:write", "reactions:read", "reactions:write"]
    }
  },
  "settings": {
    "org_deploy_enabled": false,
    "socket_mode_enabled": false
  }
}
